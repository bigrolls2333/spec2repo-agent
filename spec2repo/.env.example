# Load these into the API process environment; the application does not auto-read files.
SPEC2REPO_DATABASE_URL=mysql+pymysql://spec2repo:YOUR_DATABASE_PASSWORD@127.0.0.1:13306/spec2repo?charset=utf8mb4
SPEC2REPO_API_KEYS={"alice":"YOUR_RANDOM_API_KEY_AT_LEAST_24_CHARS","bob":"ANOTHER_RANDOM_API_KEY_AT_LEAST_24_CHARS"}
# Docker Compose reads .env. Replace both database passwords before starting.
MYSQL_PASSWORD=YOUR_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=YOUR_ROOT_PASSWORD
SPEC2REPO_REDIS_URL=redis://127.0.0.1:16379/0
SPEC2REPO_WORKSPACE_ROOT=.runtime
SPEC2REPO_RUNTIME_IMAGE=spec2repo-runtime:phase4
# Host-only OpenAI-compatible Chat Completions configuration. Never mount into the sandbox.
SPEC2REPO_MODEL_BASE_URL=https://YOUR_PROVIDER/v1
SPEC2REPO_MODEL_API_KEY=YOUR_MODEL_API_KEY
SPEC2REPO_MODEL=YOUR_CONFIGURED_MODEL
