# OpenAI-compatible LLM provider.
OPENAI_API_KEY=your-openai-compatible-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini

# Compatibility aliases supported by Paper2Repo.
OPENAI_API_BASE=
LLM_DEFAULT_MODEL=
LLM_DEFAULT_TEMPERATURE=0

# MinerU PDF parsing service.
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=your-mineru-token
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=0
MODELSCOPE_CACHE=.cache/modelscope

# Optional production evidence persistence.
# Default keeps every run self-contained with JSONL + SQLite.
PAPER2REPO_EVIDENCE_BACKEND=sqlite
PAPER2REPO_MYSQL_URI=
PAPER2REPO_MYSQL_REQUIRED=false

# Optional execution switches. Keep disabled until the generated policy is reviewed.
PAPER2REPO_EXECUTE_LLM_CODEGEN=false
PAPER2REPO_EXECUTE_LLM_REPAIR=false
PAPER2REPO_EXECUTE_LLM_REPAIR_AGENT=true
PAPER2REPO_EXECUTE_REGEN_FALLBACK=false

# Optional values used by docker-compose.mysql.yml.
MYSQL_ROOT_PASSWORD=change-me-before-starting-mysql
MYSQL_DATABASE=paper2repo
MYSQL_USER=paper2repo
MYSQL_PASSWORD=change-me-before-starting-mysql
